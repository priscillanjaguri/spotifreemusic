# Copy to `.env` in the repository root and fill in real values.
# NEVER commit `.env`.

ENVIRONMENT=development

# SQLAlchemy URL (psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://tunewise:CHANGE_ME@localhost:5432/tunewise

# Used to sign auth tokens. Must be >= 32 chars. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# JSON list of allowed frontend origins (include Capacitor WebView origins for the Android APK).
CORS_ORIGINS=["http://localhost:5173","http://localhost:5791","https://localhost","capacitor://localhost","http://localhost"]

# Used only by the test suite (a SEPARATE database -- tests wipe it).
TEST_DATABASE_URL=postgresql+psycopg://tunewise:CHANGE_ME@localhost:5432/tunewise_test

# Optional: Jamendo (Creative Commons music) client ID from https://developer.jamendo.com
# Without it the app still runs; search reports "provider not configured".
JAMENDO_CLIENT_ID=

# Development only: an invented, clearly-labelled sample catalogue with generated tones,
# used when JAMENDO_CLIENT_ID is empty. Ignored unless ENVIRONMENT=development.
DEV_MOCK_PROVIDER=false

# Set to true when served over HTTPS (production / Railway / Render).
COOKIE_SECURE=false

# Production hosts (Railway, Render) inject PORT and usually DATABASE_URL as postgresql://…
# The app rewrites that to postgresql+psycopg:// automatically. Set ENVIRONMENT=production.

# ---- My Library (uploads of music you own) ----
# Where uploads are stored when R2 is not configured (relative to the repo root by default).
# LIBRARY_STORAGE_DIR=var/library
LIBRARY_MAX_FILE_MB=200
LIBRARY_MAX_FILES_PER_REQUEST=50
# Run Librosa analysis after each upload (install backend/requirements-analysis.txt).
LIBRARY_ANALYSIS_ENABLED=true

# Optional: Cloudflare R2 storage. Set ALL FOUR to store uploads in R2 instead of on disk.
# See README "How to enable Cloudflare R2".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Lifetime of the presigned playback URLs, in seconds.
R2_PRESIGN_SECONDS=600
